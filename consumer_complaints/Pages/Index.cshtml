@page
@{
    ViewData["Title"] = "Home";
}

<section class="bg-navy text-white py-5">
    <div class="container py-4">
        <h1 class="display-6 fw-bold mb-2">Complaints Management System</h1>
        <p class="text-slate-light mb-0">
            نظام إدارة شكاوى المستهلكين.
        </p>
    </div>
</section>

<div class="container py-4">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card card-shadow h-100">
                <div class="card-body p-4">
                    <h2 class="h5">المشروع يعمل ✅</h2>
                    <p class="text-muted mb-0">
                        <code>Pages/Index.cshtml</code>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-shadow h-100">
                <div class="card-body p-4" dir="rtl">
                    <h2 class="h5">الخطوات التالية</h2>
                    <ul class="mb-0">
                        <li>إضافة الـ Models داخل <code>Models/</code>.</li>
                        <li>إضافة <code>ComplaintsDbContext</code> داخل <code>Data/</code>.</li>
                        <li>إنشاء صفحات المشروع داخل <code>Pages/</code>.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
